{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3SyncPortfolio",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::vaibhav-portfolio-site-6167beb4",
        "arn:aws:s3:::vaibhav-portfolio-site-6167beb4/*"
      ]
    },
    {
      "Sid": "CloudFrontInvalidate",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::*:distribution/E1XL3LKHI6P5LW"
    }
  ]
}
